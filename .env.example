# AUVRA Mobile App Environment Variables
# ========================================
# Copy this file to .env and fill in your values

# Cloudflare R2 Configuration
# ---------------------------
# Your R2 public bucket URL (get from Cloudflare Dashboard > R2 > Bucket > Settings)
EXPO_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Optional: Custom CDN domain (if you set up a custom domain in Cloudflare)
EXPO_PUBLIC_CDN_URL=https://images.auvra.com

# API Configuration
# -----------------
EXPO_PUBLIC_API_URL=https://auvrajuly15.onrender.com

# Firebase Authentication (required)
# ----------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# Google Authentication
# ---------------------
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Recommended for a standalone iOS/development build. The app falls back to
# the web client ID when this is omitted.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Feature Flags
# -------------
EXPO_PUBLIC_ENABLE_IMAGE_PREFETCH=true
EXPO_PUBLIC_ENABLE_OFFLINE_IMAGES=true

# Image Configuration
# -------------------
# Maximum number of images to prefetch on startup
EXPO_PUBLIC_MAX_PREFETCH_COUNT=50

# Cache settings (in milliseconds)
EXPO_PUBLIC_THUMBNAIL_CACHE_DURATION=31536000000
EXPO_PUBLIC_MEDIUM_CACHE_DURATION=2592000000
EXPO_PUBLIC_FULL_CACHE_DURATION=604800000
